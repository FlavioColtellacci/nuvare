# Copy to ".env.local" and fill in values, or run: npx vercel env pull .env.local
# Never commit .env.local or real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
# Canonical app origin used by the codebase (Stripe checkout redirects, etc.). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Not used by application code today; optional if you standardize on it elsewhere or in tooling
NEXT_PUBLIC_BASE_URL=

# --- AI ---
# MiniMax (OpenAI-compatible API) — required for POST /api/ask (orchestrator + tools).
# Create a key in MiniMax Account Management → API Keys.
# International API base (default): https://api.minimax.io/v1 — China: https://api.minimaxi.com/v1
MINIMAX_API_KEY=
# Optional overrides (defaults shown in code if unset):
# MINIMAX_API_BASE=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7

# Perplexity — required for regulatory research (tool + optional deep-research prefetch).
PERPLEXITY_API_KEY=

# Anthropic — optional: required only for routes that still call Claude directly (e.g. app/api/vault/extract) until migrated to MiniMax.
ANTHROPIC_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Optional: for Stripe.js / Elements on the client; not read by this codebase today (checkout is server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_MONTHLY_PRICE_ID=
STRIPE_CORE_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Vercel Cron (Authorization: Bearer …) ---
CRON_SECRET=

# --- Optional: Upstash Redis (rate limits for POST /api/ask and POST /api/vault/upload) ---
# Leave unset to disable limiting (default for local dev). Create a Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
