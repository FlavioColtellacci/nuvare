# Copy to ".env.local" and fill in values, or run: npx vercel env pull .env.local
# Never commit .env.local or real secrets.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
# Used by Stripe checkout success/cancel URLs and similar (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# Optional: set in Vercel if you use it elsewhere; not read by this codebase today
NEXT_PUBLIC_BASE_URL=

# --- AI ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Optional: publishable key for client-side Stripe.js; not read by this codebase today
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_MONTHLY_PRICE_ID=
STRIPE_CORE_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Vercel Cron (Authorization: Bearer …) ---
CRON_SECRET=
